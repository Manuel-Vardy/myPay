# --- App Settings ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database / Storage ---
DATABASE_URL="postgresql://user:password@localhost:5432/trite_psp"

# --- Authentication & Security ---
