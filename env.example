# --- App Settings ---
NODE_ENV=development
PORT=3000
# Canonical public URL — required for social link previews (Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Which slice of routes this deployment serves: merchant | admin | checkout | api | web
# Leave unset for a single all-in-one deployment (dev)
SERVICE_ROLE=

# Base URL of the public checkout deployment (pay.xx.com in prod). Payment
# links and payment_url responses are built against this. Inlined at build
# time (NEXT_PUBLIC_), so set it in CI for prod images.
NEXT_PUBLIC_CHECKOUT_BASE_URL=

# Base URL of the public payments API (api.xx.com in prod). Used for
# provider webhook callback URLs (ANM) and as the suggested webhook URL when
# registering Triton/Moolre in the admin Integrations tab. Same domain
# merchants use for /api/v1/*. Inlined at build time (NEXT_PUBLIC_).
NEXT_PUBLIC_API_BASE_URL=

# On the web (marketing) deployment only: where /login redirects, since the
# web role fences /api/auth and can't sign anyone in
DASHBOARD_BASE_URL=

# --- Database / Storage ---
DATABASE_URL="postgresql://user:password@localhost:5432/trite_psp"

# --- Authentication & Security ---
# Secret key for signing JWT session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your_auth_secret_here"
NEXT_PUBLIC_ENABLE_MFA="true"

# --- Mobile Money Provider ---
MOBILE_MONEY_PROVIDER=moolre

# Moolre credentials (https://docs.moolre.com)
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

# --- Crypto / Triton Microservice ---
TRITON_API_BASE_URL=http://localhost:9001
TRITON_KEY_ID=
TRITON_PRIVATE_KEY_BASE64=
TRITON_WEBHOOK_SECRET=
