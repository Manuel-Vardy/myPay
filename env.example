# --- App Settings ---
# `local` is the correct value for development, not `development`.
# src/lib/db/knexfile.ts keys its config by environment name and only the
# `local` block reads DATABASE_URL; `development` targets a Cloud SQL unix
# socket and fails on a laptop. DB_ENV does the same job for the app process
# and takes precedence over NODE_ENV — set both.
NODE_ENV=local
DB_ENV=local
PORT=3000
# Canonical public URL — required for social link previews (Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Which slice of routes this deployment serves: merchant | admin | checkout | api | web
# Leave unset for a single all-in-one deployment (dev)
SERVICE_ROLE=

# Base URL of the public checkout deployment (pay.xx.com in prod). Payment
# links and payment_url responses are built against this. Inlined at build
# time (NEXT_PUBLIC_), so set it in CI for prod images.
# Falls back to NEXT_PUBLIC_BASE_URL, then http://localhost:3000 — so leaving
# this blank is correct locally and gives you working checkout links.
NEXT_PUBLIC_CHECKOUT_BASE_URL=

# Base URL of the public payments API (api.xx.com in prod). Used for
# provider webhook callback URLs (ANM) and as the suggested webhook URL when
# registering Triton/Moolre in the admin Integrations tab. Same domain
# merchants use for /api/v1/*. Inlined at build time (NEXT_PUBLIC_).
NEXT_PUBLIC_API_BASE_URL=

# On the web (marketing) deployment only: where /login redirects, since the
# web role fences /api/auth and can't sign anyone in
DASHBOARD_BASE_URL=
# Admin portal base (ops.xx.com in prod). Used for the same redirect and to
# build password-reset links for admin accounts, which must not point at the
# merchant dashboard.
ADMIN_BASE_URL=

# --- Database / Storage ---
# Read by the `local` and `production` knexfile configs.
DATABASE_URL="postgresql://user:password@localhost:5432/trite_psp"

# The `development` knexfile config (Cloud SQL over a unix socket) uses these
# instead of DATABASE_URL. Leave blank for local work.
DB_USER=
DB_PASSWORD=
DB_NAME=
CLOUD_SQL_CONNECTION_NAME=

# Google Cloud Storage bucket holding uploaded KYC documents.
# Defaults to "trite-kyc-bucket" when unset.
GCS_BUCKET_NAME=

# --- Authentication & Security ---
# Secret key for signing JWT session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your_auth_secret_here"

# Shared bearer token for the /api/cron/* routes and the admin customer
# backfill. Without it those routes 401, so scheduled settlement payouts,
# webhook retries and provider reconciliation silently stop running.
# Generate like AUTH_SECRET. Not needed locally unless you are testing them.
CRON_SECRET=

# --- Mobile Money Provider ---
# Fallback only: the active provider is the `active_momo_provider` row in
# platform_settings, set by an admin in Settings → Integrations.
MOBILE_MONEY_PROVIDER=moolre

# Moolre credentials (https://docs.moolre.com)
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

# Paystack credentials (https://paystack.com/docs/api/charge)
# The secret key both authenticates our API calls and verifies inbound webhook
# signatures (HMAC-SHA512), so there is no separate webhook secret. It also
# authorises payouts (/transferrecipient + /transfer) when Paystack is the
# active provider — that needs Transfers enabled on the account and "OTP for
# transfers" switched OFF, or API-initiated payouts stall awaiting a code.
# Register the webhook at Settings → API Keys & Webhooks, for test and live,
# subscribed to charge.success, charge.failed, transfer.success,
# transfer.failed and transfer.reversed:
#   <NEXT_PUBLIC_API_BASE_URL>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Paystack requires an email on every charge. Used when the payer's own email
# is unknown; falls back to a per-transaction placeholder if left blank.
PAYSTACK_FALLBACK_EMAIL=

# --- Crypto / Triton Microservice ---
TRITON_API_BASE_URL=http://localhost:9001
TRITON_KEY_ID=
TRITON_PRIVATE_KEY_BASE64=
TRITON_WEBHOOK_SECRET=

# --- Device intelligence (Fingerprint Pro) ---
# Public key is inlined into the checkout bundle and is safe to expose; it can
# only request identification. Region must match the workspace's region, or the
# agent fails with wrong_region. Leave the public key blank to disable device
# identification entirely — checkout still works, payments carry no signal.
NEXT_PUBLIC_FINGERPRINT_API_KEY=
NEXT_PUBLIC_FINGERPRINT_REGION=eu
# Secret Server API key. Without it the backend cannot verify an identification
# event, and no visitor id is recorded at all — a browser-reported one would let
# an attacker mint a fresh identity per attempt and walk past every velocity
# rule. Server-side only: never prefix this NEXT_PUBLIC_.
FINGERPRINT_SERVER_API_KEY=

# --- Email (Mailjet) ---
# Both keys must be set or the app skips sending and logs the message instead,
# which is usually what you want locally.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
EMAIL_FROM=no-reply@trite.tech
# Display name on outbound mail. Defaults to "TRITE".
EMAIL_FROM_NAME=

# --- SMS / Phone verification (Arkesel OTP) ---
# Real values belong in .env (gitignored), never here. Use the MAIN SMS API key
# from the Arkesel dashboard — OTP does not work with "Multiple API Keys".
# ARKESEL_SENDER_ID is the SMS "from" name: max 11 chars, and it must be
# registered/approved in the Arkesel dashboard or sends fail with code 1003.
# Leave the key blank in dev to fall back to the 000000 bypass code.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Trite
# Override the Arkesel endpoint. Defaults to https://sms.arkesel.com.
ARKESEL_BASE_URL=

# --- ANM (alternate mobile money gateway) ---
# Override the ANM endpoint. Defaults to https://orchard-api.anmgw.com.
# Callback URLs are built from NEXT_PUBLIC_API_BASE_URL, never from the
# request host — provider webhooks always land on the payments service.
ANM_BASE_URL=

# --- TMOS (opt-in shop management) ---
# Base URL of the TMOS deployment (mos.trite.tech in prod). The merchant
# dashboard builds its "Open shop management" link against this; leave blank
# to hide the link entirely.
TMOS_BASE_URL=http://localhost:3001
# Signing key for the short-lived handoff token that bootstraps a merchant
# owner into TMOS (generate with: openssl rand -base64 32).
#
# MUST NOT be AUTH_SECRET. TMOS runs its own auth realm because shop staff log
# in there directly; sharing the key would make any TMOS-issued token a valid
# Trite session cookie, turning a TMOS compromise into merchant-portal access.
TMOS_HANDOFF_SECRET=
# Audience claim the TMOS side verifies. Must match its own configuration.
TMOS_HANDOFF_AUDIENCE=mos.trite.tech
