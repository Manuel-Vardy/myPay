# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

/.idea/
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Working notes and reference material stay local; they are shared out of band.
# Written as /knowledge/* rather than /knowledge/ so a single file can be
# re-included with a ! rule later — that is impossible once the directory
# itself is excluded.
/knowledge/*
/.claude/
/scripts/

# test coverage
coverage

# Belt and braces alongside .dockerignore: never let a CI credentials file be
# committed if one is ever produced in a working tree.
gha-creds-*.json
